---
import { getCollection } from "astro:content";

import BlogPostCard from "../../components/blog-post-card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => post.data.isPublished !== false && post.data.isDraft !== true);

  const tags = new Set<string>();
  posts.forEach((post) => {
    post.data.tags?.forEach(tag => tags.add(tag));
  });

  return Array.from(tags).map((tag) => {
    const slug = tag.toLowerCase().replace(/\s+/g, "-");
    const filteredPosts = posts
      .filter(post => post.data.tags?.includes(tag))
      .sort((a, b) => {
        const dateA = a.data.pubDate || a.data.date;
        const dateB = b.data.pubDate || b.data.date;
        if (!dateA || !dateB) return 0;
        return dateB.valueOf() - dateA.valueOf();
      });

    return {
      params: { slug },
      props: { tag, posts: filteredPosts },
    };
  });
}

const { tag, posts } = Astro.props;

export const prerender = true;
---

<Layout title={`Posts tagged "${tag}" - ${SITE_TITLE}`} description={`All posts tagged with ${tag} on ${SITE_DESCRIPTION}`}>
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <a href="/tags/" class="back-link">← All tags</a>
      <header class="tag-hero">
        <p>Topic</p>
        <h1>{tag}</h1>
        <span>{posts.length} {posts.length === 1 ? "post" : "posts"}</span>
      </header>
      <ul class="tag-posts">
        {posts.map(post => <BlogPostCard post={post} />)}
      </ul>
    </div>
  </main>
</Layout>

<style>
  .back-link {
    display: inline-flex;
    margin-bottom: 1rem;
    color: rgb(20 184 166);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tag-hero {
    border: 1px dashed rgb(212 212 216);
    border-radius: 2rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    background: rgb(255 255 255 / 0.72);
  }

  .tag-hero p {
    margin: 0 0 0.75rem;
    color: rgb(20 184 166);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tag-hero h1 {
    max-width: 11ch;
    color: rgb(39 39 42);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .tag-hero span {
    display: inline-flex;
    margin-top: 1.25rem;
    border-radius: 999px;
    background: rgb(244 244 245);
    padding: 0.45rem 0.75rem;
    color: rgb(82 82 91);
    font-size: 0.8125rem;
  }

  .tag-posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.dark) .tag-hero {
    border-color: rgb(63 63 70);
    background: rgb(24 24 27 / 0.72);
  }

  :global(.dark) .tag-hero h1 {
    color: rgb(244 244 245);
  }

  :global(.dark) .tag-hero span {
    background: rgb(39 39 42);
    color: rgb(212 212 216);
  }
</style>
