---
import { getCollection } from "astro:content";

import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .filter(post => post.data.isPublished !== false && post.data.isDraft !== true);

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Layout title={`Tags - ${SITE_TITLE}`} description={`Browse all tags on ${SITE_DESCRIPTION}`}>
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="tags-hero">
        <p>Index</p>
        <h1>Topics I return to.</h1>
        <span>{sortedTags.length} tags across {posts.length} notes</span>
      </header>

      <section class="tag-cloud" aria-label="All tags">
        {sortedTags.map(([tag, count]) => (
          <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`} style={`--tag-size: ${Math.min(1.45, 0.85 + count / 14)}rem`}>
            <span>{tag}</span>
            <strong>{count}</strong>
          </a>
        ))}
      </section>
    </div>
  </main>
</Layout>

<style>
  .tags-hero {
    border: 1px dashed rgb(212 212 216);
    border-radius: 2rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    background: rgb(255 255 255 / 0.72);
  }

  .tags-hero p {
    margin: 0 0 0.75rem;
    color: rgb(20 184 166);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tags-hero h1 {
    max-width: 10ch;
    color: rgb(39 39 42);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .tags-hero span {
    display: inline-flex;
    margin-top: 1.25rem;
    border-radius: 999px;
    background: rgb(244 244 245);
    padding: 0.45rem 0.75rem;
    color: rgb(82 82 91);
    font-size: 0.8125rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .tag-cloud a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    border: 1px dashed rgb(212 212 216);
    border-radius: 999px;
    background: white;
    padding: 0.45rem 0.75rem;
    color: rgb(63 63 70);
    text-decoration: none;
    transition: border-color 160ms ease, transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tag-cloud a:hover,
  .tag-cloud a:focus-visible {
    border-color: rgb(20 184 166 / 0.7);
    transform: translateY(-1px);
  }

  .tag-cloud a:focus-visible {
    outline: 2px solid rgb(20 184 166 / 0.28);
    outline-offset: 3px;
  }

  .tag-cloud span {
    font-size: var(--tag-size);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .tag-cloud strong {
    color: rgb(161 161 170);
    font-size: 0.75rem;
  }

  :global(.dark) .tags-hero,
  :global(.dark) .tag-cloud a {
    border-color: rgb(63 63 70);
    background: rgb(24 24 27 / 0.72);
  }

  :global(.dark) .tags-hero h1,
  :global(.dark) .tag-cloud a {
    color: rgb(244 244 245);
  }

  :global(.dark) .tags-hero span {
    background: rgb(39 39 42);
    color: rgb(212 212 216);
  }
</style>
