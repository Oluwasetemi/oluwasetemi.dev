---
import { getCollection } from "astro:content";

import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .filter(post => post.data.isPublished !== false && post.data.isDraft !== true);

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Layout title={`Tags - ${SITE_TITLE}`} description={`Browse all tags on ${SITE_DESCRIPTION}`}>
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="tags-hero">
        <p>Index</p>
        <h1>Topics I return to.</h1>
        <span>{sortedTags.length} tags across {posts.length} notes</span>
      </header>

      <section class="tag-cloud" aria-label="All tags">
        {sortedTags.map(([tag, count]) => (
          <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`} style={`--tag-size: ${Math.min(1.45, 0.85 + count / 14)}rem`}>
            <span>{tag}</span>
            <strong>{count}</strong>
          </a>
        ))}
      </section>
    </div>
  </main>
</Layout>

<style>
  .tags-hero {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-hero);
    background: var(--color-surface-panel);
    padding: clamp(1.5rem, 5vw, 3rem);

    p {
      margin: 0 0 0.75rem;
      color: var(--color-accent);
      font-size: 0.875rem;
      font-weight: 600;
    }

    h1 {
      max-inline-size: 10ch;
      color: var(--color-heading);
      font-size: clamp(3rem, 8vw, 6.5rem);
      font-weight: 760;
      letter-spacing: -0.075em;
      line-height: 0.9;
    }

    span {
      display: inline-flex;
      margin-block-start: 1.25rem;
      border-radius: 999px;
      background: var(--color-surface-muted);
      padding: 0.45rem 0.75rem;
      color: var(--color-copy);
      font-size: 0.8125rem;
    }
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-block-start: 2rem;

    a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.5rem;
      border: 1px dashed var(--color-border);
      border-radius: 999px;
      background: var(--color-surface-panel);
      padding: 0.45rem 0.75rem;
      color: var(--color-copy);
      text-decoration: none;
      transition: border-color var(--transition-color), transform var(--transition-movement);

      &:is(:hover, :focus-visible) {
        border-color: color-mix(in srgb, var(--color-accent) 70%, transparent);
        transform: translateY(-1px);
      }

      &:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
        outline-offset: 3px;
      }
    }

    span {
      font-size: var(--tag-size);
      font-weight: 600;
      letter-spacing: -0.04em;
    }

    strong {
      color: var(--color-subtle);
      font-size: 0.75rem;
    }
  }
</style>
