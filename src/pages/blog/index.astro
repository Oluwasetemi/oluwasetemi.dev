---
import { getCollection } from "astro:content";

import BlogPostCard from "../../components/blog-post-card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .filter(post => post.data.isPublished !== false && post.data.isDraft !== true)
  .sort((a, b) => {
    const dateA = a.data.pubDate || a.data.date;
    const dateB = b.data.pubDate || b.data.date;
    if (!dateA || !dateB) return 0;
    return dateB.valueOf() - dateA.valueOf();
  });
---

<Layout title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} image="/og/page/blog.png">
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="archive-hero">
        <p>Notebook</p>
        <h1>Writing from the workbench.</h1>
        <span>{posts.length} published notes</span>
      </header>

      <section class="archive-board" aria-label="Articles">
        <ul class="archive-list">
          {posts.map(post => <BlogPostCard post={post} />)}
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style>
  .archive-hero {
    display: grid;
    gap: 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-hero);
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 22rem),
      var(--color-surface-panel);
    padding: clamp(1.5rem, 5vw, 3rem);

    p {
      margin: 0;
      color: var(--color-accent);
      font-size: 0.875rem;
      font-weight: 600;
    }

    h1 {
      max-inline-size: 12ch;
      color: var(--color-heading);
      font-size: clamp(3rem, 8vw, 6.5rem);
      font-weight: 760;
      letter-spacing: -0.075em;
      line-height: 0.9;
    }

    span {
      inline-size: fit-content;
      border-radius: 999px;
      background: var(--color-surface-muted);
      padding: 0.45rem 0.75rem;
      color: var(--color-copy);
      font-size: 0.8125rem;
    }
  }

  .archive-board {
    position: relative;
    margin-block-start: 3rem;

    &::before {
      position: absolute;
      inset: 0 auto 0 0.35rem;
      inline-size: 1px;
      background-image: linear-gradient(to bottom, color-mix(in srgb, var(--color-accent) 35%, transparent) 45%, transparent 0);
      background-size: 1px 0.75rem;
      content: "";
    }
  }

  .archive-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0 0 0 2rem;
    list-style: none;
  }
</style>
