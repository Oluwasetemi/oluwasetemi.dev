---
import { getCollection, render } from "astro:content";

import BlogPost from "../../layouts/blogpost.astro";
import { getEntrySlug } from "../../utils/content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => post.data.isPublished !== false && post.data.isDraft !== true);
  return posts.map(post => ({
    params: { slug: getEntrySlug(post) },
    props: post,
  }));
}
const post = Astro.props;
const { Content, headings } = await render(post);
const postSlug = getEntrySlug(post);

// Generate OG image URL
const ogImage = `/og/blog/${postSlug}.png`;

export const prerender = true;
---

<BlogPost {...post.data} banner={post.data.banner as ImageMetadata} bannerCredit={post.data.bannerCredit} headings={headings} ogImage={ogImage}>
  <Content />
</BlogPost>
