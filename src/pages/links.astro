---
import Layout from "../layouts/Layout.astro";
import { SOCIALS } from "../consts";
---

<Layout title="Links - Oluwasetemi" description="Important links, social media, and resources">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 text-gray-800">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 sm:mb-6 text-gray-900">
      Links
      <span role="img" aria-label="links">🔗</span>
    </h1>

    <p class="mb-8 leading-relaxed text-gray-600">
      Here are some important links to my work, social media, and resources I find valuable.
    </p>

    <!-- Social Media -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-gray-900 border-b border-gray-200 pb-2">Social Media</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href={`https://github.com/${SOCIALS.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div class="w-12 h-12 bg-gray-900 rounded-lg flex items-center justify-center text-white text-xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors">GitHub</h3>
            <p class="text-sm text-gray-600">Code repositories and projects</p>
          </div>
        </a>

        <a
          href={`https://twitter.com/${SOCIALS.twitter}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div class="w-12 h-12 bg-blue-500 rounded-lg flex items-center justify-center text-white text-xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">Twitter</h3>
            <p class="text-sm text-gray-600">Thoughts and updates</p>
          </div>
        </a>

        <a
          href={`https://linkedin.com/in/${SOCIALS.linkedIn}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div class="w-12 h-12 bg-blue-700 rounded-lg flex items-center justify-center text-white text-xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-blue-700 transition-colors">LinkedIn</h3>
            <p class="text-sm text-gray-600">Professional network</p>
          </div>
        </a>

        <a
          href={`https://stackblitz.com/${SOCIALS.stackblitz}`}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div class="w-12 h-12 bg-orange-500 rounded-lg flex items-center justify-center text-white text-xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2c5.514 0 10 4.486 10 10s-4.486 10-10 10S2 17.514 2 12 6.486 2 12 2zm-1 6H9v8h2V8zm4 0h-2v8h2V8z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-orange-600 transition-colors">StackBlitz</h3>
            <p class="text-sm text-gray-600">Online code demos</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Teaching & Education -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-gray-900 border-b border-gray-200 pb-2">
        Teaching & Education
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="https://tripleten.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg flex items-center justify-center text-white text-xl font-bold"
          >
            TT
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">TripleTen</h3>
            <p class="text-sm text-gray-600">Tutor - Web Development</p>
          </div>
        </a>

        <a
          href="https://altschoolafrica.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-green-600 to-blue-600 rounded-lg flex items-center justify-center text-white text-xl font-bold"
          >
            AS
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-green-600 transition-colors">AltSchool Africa</h3>
            <p class="text-sm text-gray-600">Frontend Engineering Instructor</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Community & Resources -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-gray-900 border-b border-gray-200 pb-2">
        Community & Resources
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="https://discord.gg/zUQpSXg"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div class="w-12 h-12 bg-indigo-600 rounded-lg flex items-center justify-center text-white text-xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419-.019 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1568 2.4189Z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors">Discord Community</h3>
            <p class="text-sm text-gray-600">Join our developer community</p>
          </div>
        </a>

        <a
          href="/blog"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-purple-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-purple-600 transition-colors">Blog</h3>
            <p class="text-sm text-gray-600">Articles and tutorials</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Portfolio & Projects -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-gray-900 border-b border-gray-200 pb-2">
        Portfolio & Projects
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="/portfolio"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-green-600 to-blue-600 rounded-lg flex items-center justify-center text-white text-xl"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-green-600 transition-colors">Portfolio</h3>
            <p class="text-sm text-gray-600">View my projects and work</p>
          </div>
        </a>

        <a
          href="/uses"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-orange-600 to-red-600 rounded-lg flex items-center justify-center text-white text-xl"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-orange-600 transition-colors">Uses</h3>
            <p class="text-sm text-gray-600">Tools and setup I use</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Contact -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6 text-gray-900 border-b border-gray-200 pb-2">Get In Touch</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="/contact"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-lg flex items-center justify-center text-white text-xl"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">Contact Me</h3>
            <p class="text-sm text-gray-600">Send me a message</p>
          </div>
        </a>

        <a
          href="mailto:hello@oluwasetemi.dev"
          class="group bg-white rounded-lg p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 flex items-center gap-4"
        >
          <div
            class="w-12 h-12 bg-gradient-to-r from-red-600 to-pink-600 rounded-lg flex items-center justify-center text-white text-xl"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 group-hover:text-red-600 transition-colors">Email</h3>
            <p class="text-sm text-gray-600">me@oluwasetemi.dev || setemiojo@gmail.com</p>
          </div>
        </a>
      </div>
    </section>

    <div class="text-center mt-8 pt-6 border-t border-gray-200">
      <p class="text-gray-600 text-sm">
        Feel free to reach out for collaborations, questions, or just to say hello!
        <br class="hidden sm:block" />
        I'm always open to connecting with fellow developers and creators.
      </p>
    </div>
  </main>
</Layout>
