---
import { SOCIALS } from "../consts";
import Layout from "../layouts/Layout.astro";

const linkSections = [
  {
    title: "Places I publish",
    note: "Code, writing, and public work.",
    links: [
      {
        title: "GitHub",
        href: `https://github.com/${SOCIALS.github}`,
        description: "Repositories, experiments, and open source work.",
        mark: "GH",
        external: true,
      },
      {
        title: "Blog",
        href: "/blog",
        description: "Longer notes on web development and teaching.",
        mark: "WR",
      },
      {
        title: "Portfolio",
        href: "/portfolio",
        description: "Selected projects, client work, and demos.",
        mark: "PF",
      },
      {
        title: "StackBlitz",
        href: `https://stackblitz.com/${SOCIALS.stackblitz}`,
        description: "Small runnable examples and quick prototypes.",
        mark: "SB",
        external: true,
      },
    ],
  },
  {
    title: "Where to find me",
    note: "Low-friction ways to connect.",
    links: [
      {
        title: "LinkedIn",
        href: `https://linkedin.com/in/${SOCIALS.linkedIn}`,
        description: "Professional network and work updates.",
        mark: "IN",
        external: true,
      },
      {
        title: "X / Twitter",
        href: `https://x.com/${SOCIALS.twitter.replace(/^@/, "")}`,
        description: "Thoughts, links, and quick notes.",
        mark: "X",
        external: true,
      },
      {
        title: "Discord Community",
        href: "https://discord.gg/zUQpSXg",
        description: "Developer conversations and community support.",
        mark: "DC",
        external: true,
      },
      {
        title: "Email",
        href: "mailto:hello@oluwasetemi.dev",
        description: "For direct messages and collaboration ideas.",
        mark: "@",
      },
    ],
  },
  {
    title: "Teaching and useful doors",
    note: "The practical links people ask for most.",
    links: [
      {
        title: "AltSchool Africa",
        href: "https://altschoolafrica.com",
        description: "Where I teach frontend engineering.",
        mark: "AS",
        external: true,
      },
      {
        title: "Uses",
        href: "/uses",
        description: "The tools and setup I keep around.",
        mark: "US",
      },
      {
        title: "Contact",
        href: "/contact",
        description: "Book time or send a focused message.",
        mark: "ME",
      },
    ],
  },
];
---

<Layout title="Links - Oluwasetemi" description="Important links, social media, and resources" image="/og/page/links.png">
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="links-hero">
        <div>
          <p class="links-kicker">Route board</p>
          <h1>Links worth keeping close.</h1>
        </div>
        <p>
          A compact map to my work, teaching, writing, and places where a conversation can start without ceremony.
        </p>
      </header>

      <div class="links-board" aria-label="Link collections">
        {linkSections.map((section, sectionIndex) => (
          <section class="link-section" aria-labelledby={`links-section-${sectionIndex}`}>
            <header class="link-section-header">
              <div>
                <h2 id={`links-section-${sectionIndex}`}>{section.title}</h2>
                <p>{section.note}</p>
              </div>
              <span aria-hidden="true">{String(sectionIndex + 1).padStart(2, "0")}</span>
            </header>
            <ul class="link-grid">
              {section.links.map(link => (
                <li>
                  <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined} class="link-card">
                    <span class="link-mark" aria-hidden="true">{link.mark}</span>
                    <span class="link-copy">
                      <strong>{link.title}</strong>
                      <span>{link.description}</span>
                    </span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.75 5.75 9.25 8l-2.5 2.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .links-hero {
    display: grid;
    align-items: end;
    gap: 1.5rem;

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.7fr);
    }

    h1 {
      max-inline-size: 11ch;
      color: var(--color-heading);
      font-size: clamp(3rem, 8vw, 6.8rem);
      font-weight: 760;
      letter-spacing: -0.075em;
      line-height: 0.88;
    }

    & > p {
      margin: 0;
      color: var(--color-copy);
      font-size: 1rem;
      line-height: 1.8;
    }
  }

  .links-kicker {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .links-board {
    position: relative;
    margin-block-start: 4rem;

    &::before {
      position: absolute;
      inset: -1.25rem auto -1.25rem 0.55rem;
      inline-size: 1px;
      background-image: linear-gradient(to bottom, color-mix(in srgb, var(--color-accent) 35%, transparent) 45%, transparent 0);
      background-size: 1px 0.75rem;
      content: "";
    }
  }

  .link-section {
    position: relative;
    padding: 0 0 2.5rem 2.25rem;

    &::before {
      position: absolute;
      inset: 0.35rem auto auto 0.2rem;
      block-size: 0.75rem;
      inline-size: 0.75rem;
      border-radius: 999px;
      background: var(--color-surface);
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 70%, transparent),
        0 0 0 0.35rem color-mix(in srgb, var(--color-accent) 8%, transparent);
      content: "";
    }
  }

  .link-section-header {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-block-end: 1rem;

    h2 {
      margin: 0;
      color: var(--color-heading);
      font-size: 1.125rem;
      letter-spacing: -0.03em;
    }

    p {
      margin: 0.25rem 0 0;
      color: var(--color-muted);
      font-size: 0.875rem;
    }

    & > span {
      color: var(--color-border);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.06em;
    }
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-block-size: 6.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-surface-panel);
    padding: 1rem;
    text-decoration: none;
    transition: border-color var(--transition-color), background-color var(--transition-color), transform var(--transition-movement);

    &:is(:hover, :focus-visible) {
      border-color: color-mix(in srgb, var(--color-accent) 75%, transparent);
      background: var(--color-surface);
      transform: translateY(-2px);

      svg {
        color: var(--color-accent);
        transform: translateX(2px);
      }
    }

    &:active {
      transform: translateY(0) scale(0.99);
    }

    &:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
      outline-offset: 3px;
    }

    svg {
      block-size: 1rem;
      inline-size: 1rem;
      color: var(--color-subtle);
      transition: color var(--transition-color), transform var(--transition-movement);
    }
  }

  .link-mark {
    display: grid;
    block-size: 2.5rem;
    inline-size: 2.5rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-surface-muted);
    color: var(--color-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .link-copy {
    display: grid;
    gap: 0.25rem;

    strong {
      color: var(--color-heading);
      font-size: 0.95rem;
    }

    span {
      color: var(--color-muted);
      font-size: 0.8125rem;
      line-height: 1.45;
    }
  }
</style>
