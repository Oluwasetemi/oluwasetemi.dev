---
import { SOCIALS } from "../consts";
import Layout from "../layouts/Layout.astro";

const linkSections = [
  {
    title: "Places I publish",
    note: "Code, writing, and public work.",
    links: [
      {
        title: "GitHub",
        href: `https://github.com/${SOCIALS.github}`,
        description: "Repositories, experiments, and open source work.",
        mark: "GH",
        external: true,
      },
      {
        title: "Blog",
        href: "/blog",
        description: "Longer notes on web development and teaching.",
        mark: "WR",
      },
      {
        title: "Portfolio",
        href: "/portfolio",
        description: "Selected projects, client work, and demos.",
        mark: "PF",
      },
      {
        title: "StackBlitz",
        href: `https://stackblitz.com/${SOCIALS.stackblitz}`,
        description: "Small runnable examples and quick prototypes.",
        mark: "SB",
        external: true,
      },
    ],
  },
  {
    title: "Where to find me",
    note: "Low-friction ways to connect.",
    links: [
      {
        title: "LinkedIn",
        href: `https://linkedin.com/in/${SOCIALS.linkedIn}`,
        description: "Professional network and work updates.",
        mark: "IN",
        external: true,
      },
      {
        title: "X / Twitter",
        href: `https://x.com/${SOCIALS.twitter.replace(/^@/, "")}`,
        description: "Thoughts, links, and quick notes.",
        mark: "X",
        external: true,
      },
      {
        title: "Discord Community",
        href: "https://discord.gg/zUQpSXg",
        description: "Developer conversations and community support.",
        mark: "DC",
        external: true,
      },
      {
        title: "Email",
        href: "mailto:hello@oluwasetemi.dev",
        description: "For direct messages and collaboration ideas.",
        mark: "@",
      },
    ],
  },
  {
    title: "Teaching and useful doors",
    note: "The practical links people ask for most.",
    links: [
      {
        title: "AltSchool Africa",
        href: "https://altschoolafrica.com",
        description: "Where I teach frontend engineering.",
        mark: "AS",
        external: true,
      },
      {
        title: "Uses",
        href: "/uses",
        description: "The tools and setup I keep around.",
        mark: "US",
      },
      {
        title: "Contact",
        href: "/contact",
        description: "Book time or send a focused message.",
        mark: "ME",
      },
    ],
  },
];
---

<Layout title="Links - Oluwasetemi" description="Important links, social media, and resources" image="/og/page/links.png">
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="links-hero">
        <div>
          <p class="links-kicker">Route board</p>
          <h1>Links worth keeping close.</h1>
        </div>
        <p>
          A compact map to my work, teaching, writing, and places where a conversation can start without ceremony.
        </p>
      </header>

      <div class="links-board" aria-label="Link collections">
        {linkSections.map((section, sectionIndex) => (
          <section class="link-section" aria-labelledby={`links-section-${sectionIndex}`}>
            <header class="link-section-header">
              <div>
                <h2 id={`links-section-${sectionIndex}`}>{section.title}</h2>
                <p>{section.note}</p>
              </div>
              <span aria-hidden="true">{String(sectionIndex + 1).padStart(2, "0")}</span>
            </header>
            <ul class="link-grid">
              {section.links.map(link => (
                <li>
                  <a href={link.href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined} class="link-card">
                    <span class="link-mark" aria-hidden="true">{link.mark}</span>
                    <span class="link-copy">
                      <strong>{link.title}</strong>
                      <span>{link.description}</span>
                    </span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.75 5.75 9.25 8l-2.5 2.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .links-hero {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }

  @media (min-width: 768px) {
    .links-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.7fr);
    }
  }

  .links-kicker {
    margin: 0 0 0.75rem;
    color: rgb(20 184 166);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .links-hero h1 {
    max-width: 11ch;
    color: rgb(39 39 42);
    font-size: clamp(3rem, 8vw, 6.8rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.88;
  }

  .links-hero > p {
    margin: 0;
    color: rgb(82 82 91);
    font-size: 1rem;
    line-height: 1.8;
  }

  .links-board {
    position: relative;
    margin-top: 4rem;
  }

  .links-board::before {
    position: absolute;
    inset: -1.25rem auto -1.25rem 0.55rem;
    width: 1px;
    background-image: linear-gradient(to bottom, rgb(20 184 166 / 0.35) 45%, transparent 0);
    background-size: 1px 0.75rem;
    content: "";
  }

  .link-section {
    position: relative;
    padding: 0 0 2.5rem 2.25rem;
  }

  .link-section::before {
    position: absolute;
    left: 0.2rem;
    top: 0.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: white;
    box-shadow: inset 0 0 0 1px rgb(20 184 166 / 0.7), 0 0 0 0.35rem rgb(20 184 166 / 0.08);
    content: "";
  }

  .link-section-header {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .link-section-header h2 {
    margin: 0;
    color: rgb(39 39 42);
    font-size: 1.125rem;
    letter-spacing: -0.03em;
  }

  .link-section-header p {
    margin: 0.25rem 0 0;
    color: rgb(113 113 122);
    font-size: 0.875rem;
  }

  .link-section-header > span {
    color: rgb(212 212 216);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 6.5rem;
    border: 1px dashed rgb(212 212 216);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.78);
    padding: 1rem;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .link-card:hover,
  .link-card:focus-visible {
    border-color: rgb(20 184 166 / 0.75);
    background: white;
    transform: translateY(-2px);
  }

  .link-card:active {
    transform: translateY(0) scale(0.99);
  }

  .link-card:focus-visible {
    outline: 2px solid rgb(20 184 166 / 0.28);
    outline-offset: 3px;
  }

  .link-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 999px;
    background: rgb(244 244 245);
    color: rgb(39 39 42);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .link-copy {
    display: grid;
    gap: 0.25rem;
  }

  .link-copy strong {
    color: rgb(39 39 42);
    font-size: 0.95rem;
  }

  .link-copy span {
    color: rgb(113 113 122);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .link-card svg {
    width: 1rem;
    height: 1rem;
    color: rgb(161 161 170);
    transition: color 160ms ease, transform 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .link-card:hover svg,
  .link-card:focus-visible svg {
    color: rgb(20 184 166);
    transform: translateX(2px);
  }

  :global(.dark) .links-hero h1,
  :global(.dark) .link-section-header h2,
  :global(.dark) .link-copy strong {
    color: rgb(244 244 245);
  }

  :global(.dark) .links-hero > p,
  :global(.dark) .link-copy span,
  :global(.dark) .link-section-header p {
    color: rgb(161 161 170);
  }

  :global(.dark) .link-card {
    border-color: rgb(63 63 70);
    background: rgb(24 24 27 / 0.72);
  }

  :global(.dark) .link-card:hover,
  :global(.dark) .link-card:focus-visible {
    border-color: rgb(45 212 191 / 0.65);
    background: rgb(24 24 27);
  }

  :global(.dark) .link-mark {
    background: rgb(39 39 42);
    color: rgb(244 244 245);
  }
</style>
