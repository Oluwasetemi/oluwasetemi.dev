---
import type { CollectionEntry } from "astro:content";

import { getCollection } from "astro:content";

import BlogPostCard from "../components/blog-post-card.astro";
import PortfolioCard from "../components/portfolio-card.astro";
import { SITE_DESCRIPTION, SITE_TITLE, SOCIALS } from "../consts";
import Layout from "../layouts/Layout.astro";

const allPosts: CollectionEntry<"blog">[] = (await getCollection("blog"))
  .filter((post: CollectionEntry<"blog">) => post.data.isPublished !== false && post.data.isDraft !== true)
  .sort((a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => {
    const dateA = a.data.pubDate || a.data.date;
    const dateB = b.data.pubDate || b.data.date;
    if (!dateA || !dateB) return 0;
    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 4);

const portfolios: CollectionEntry<"portfolio">[] = (await getCollection("portfolio"))
  .sort((a: CollectionEntry<"portfolio">, b: CollectionEntry<"portfolio">) => {
    const dateA = a.data.publishedDate;
    const dateB = b.data.publishedDate;
    if (!dateA || !dateB) return 0;
    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 4);

const photos = [
  { src: "/images/setemi.jpg", rotate: "rotate-2" },
  { src: "/images/setemi-model.jpg", rotate: "-rotate-2" },
  { src: "/images/setemi-with-temi.jpg", rotate: "rotate-2" },
  { src: "/images/setemi-model-2.jpg", rotate: "rotate-2" },
  { src: "/images/temi.jpg", rotate: "-rotate-2" },
];

const work = [
  { role: "Frontend Engineering Instructor", company: "AltSchool Africa", period: "Now" },
  { role: "Consultant · FullStack Engineer", company: "Intellubus", period: "Now" },
  { role: "Technical Writer", company: "oluwasetemi.dev", period: "Writing" },
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} image="/og/page/home.png">
  <main id="main-content" tabindex="-1">
    <section class="page-container mt-16 sm:mt-20">
      <div class="content-container">
        <div class="max-w-2xl">
          <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
            Fullstack engineer, educator, and builder of thoughtful web experiences.
          </h1>
          <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400">
            <span class="rounded-full border border-dashed border-teal-500/40 bg-teal-50 px-2 py-1 font-medium text-zinc-900 dark:bg-teal-400/10 dark:text-zinc-100">I’m Oluwasetemi Ojo</span>. I build web applications with TypeScript, JavaScript, React, and Node.js, and I help the next generation of frontend engineers grow at AltSchool Africa.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-4 text-zinc-500 dark:text-zinc-400">
            <a href={`https://github.com/${SOCIALS.github}`} target="_blank" rel="noopener noreferrer" class="transition hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="GitHub">GitHub</a>
            <a href={`https://linkedin.com/in/${SOCIALS.linkedIn}`} target="_blank" rel="noopener noreferrer" class="transition hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="LinkedIn">LinkedIn</a>
            <a href={`https://stackblitz.com/${SOCIALS.stackblitz}`} target="_blank" rel="noopener noreferrer" class="transition hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="StackBlitz">StackBlitz</a>

          </div>
        </div>
      </div>
    </section>

    <div class="mt-16 sm:mt-20">
      <div class="-my-4 flex justify-center gap-5 overflow-hidden py-4 sm:gap-8">
        {photos.map(photo => (
          <div class:list={["relative aspect-9/10 w-44 flex-none overflow-hidden rounded-xl bg-zinc-100 sm:w-72 sm:rounded-2xl dark:bg-zinc-800", photo.rotate]}>
            <img src={photo.src} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <section class="page-container mt-24 md:mt-28">
      <div class="content-container grid grid-cols-1 gap-y-20 lg:grid-cols-2 lg:gap-x-16 xl:gap-x-24">
        <div>
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Latest writing</h2>
            <a href="/blog" class="text-sm font-medium text-teal-500 hover:text-teal-600 dark:text-teal-400">All articles</a>
          </div>
          <ul class="mt-8 grid list-none gap-12 p-0">
            {allPosts.map(post => <BlogPostCard post={post} />)}
          </ul>
        </div>

        <div class="space-y-10">
          <section class="rounded-2xl border border-zinc-100 p-6 dark:border-zinc-700/40">
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Work</h2>
            <ol class="mt-6 space-y-4">
              {work.map(item => (
                <li class="flex gap-4">
                  <div class="mt-1 flex h-10 w-10 flex-none items-center justify-center rounded-full bg-white text-sm font-semibold text-teal-500 shadow-md ring-1 shadow-zinc-800/5 ring-zinc-900/5 dark:bg-zinc-800 dark:ring-white/10">{item.company[0]}</div>
                  <dl class="flex flex-auto flex-wrap gap-x-2">
                    <dt class="sr-only">Company</dt>
                    <dd class="w-full flex-none text-sm font-medium text-zinc-900 dark:text-zinc-100">{item.company}</dd>
                    <dt class="sr-only">Role</dt>
                    <dd class="text-xs text-zinc-500 dark:text-zinc-400">{item.role}</dd>
                    <dt class="sr-only">Period</dt>
                    <dd class="ml-auto text-xs text-zinc-400 dark:text-zinc-500">{item.period}</dd>
                  </dl>
                </li>
              ))}
            </ol>
          </section>

          {portfolios.length > 0 && (
            <section>
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Selected projects</h2>
                <a href="/portfolio" class="text-sm font-medium text-teal-500 hover:text-teal-600 dark:text-teal-400">All projects</a>
              </div>
              <ul class="mt-6 grid list-none gap-4 p-0">
                {portfolios.map(portfolio => <PortfolioCard portfolio={portfolio} />)}
              </ul>
            </section>
          )}
        </div>
      </div>
    </section>
  </main>
</Layout>
