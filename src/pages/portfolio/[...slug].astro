---
import type { CollectionEntry } from "astro:content";

import { getCollection } from "astro:content";

import { SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";

type Props = CollectionEntry<"portfolio">;

export async function getStaticPaths() {
  const portfolios = await getCollection("portfolio");
  return portfolios
    .map(portfolio => ({
      params: { slug: portfolio.slug },
      props: portfolio,
    }))
    .sort((a, b) => {
      const dateA = new Date(a.props.data.publishedDate as Date);
      const dateB = new Date(b.props.data.publishedDate as Date);
      return dateA.getTime() - dateB.getTime();
    })
    .filter(portfolio => portfolio.props.data.isPublished);
}

const portfolio = Astro.props;
const { Content } = await portfolio.render();

export const prerender = true;
---

<Layout
  title={`${portfolio.data.title} - ${SITE_TITLE}`}
  description={portfolio.data.description || `Portfolio project: ${portfolio.data.title}`}
>
  <main class="max-w-4xl mx-auto px-8 py-8">
    <div class="mb-12 text-center">
      <h1
        class="text-5xl md:text-3xl mb-4 bg-gradient-to-r from-indigo-500 to-purple-600 bg-clip-text text-transparent"
      >
        {portfolio.data.title}
      </h1>
      {portfolio.data.description && <p class="text-xl text-gray-600">{portfolio.data.description}</p>}
    </div>

    <div class="flex justify-center gap-4 mb-8 flex-wrap">
      {
        portfolio.data.url && (
          <a
            href={portfolio.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-6 py-3 rounded-md no-underline font-medium hover:-translate-y-0.5 transition-transform duration-200"
          >
            Live Demo
          </a>
        )
      }
      {
        portfolio.data.github && (
          <a
            href={portfolio.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-6 py-3 rounded-md no-underline font-medium hover:-translate-y-0.5 transition-transform duration-200"
          >
            GitHub
          </a>
        )
      }
    </div>

    {
      portfolio.data.tags && (
        <div class="flex justify-center gap-2 mb-8 flex-wrap">
          {portfolio.data.tags.map((tag: string) => (
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">{tag}</span>
          ))}
        </div>
      )
    }

    <div class="prose prose-lg max-w-none text-gray-800 leading-relaxed">
      <Content />
    </div>
  </main>
</Layout>
