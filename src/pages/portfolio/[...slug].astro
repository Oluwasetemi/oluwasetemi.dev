---
import type { CollectionEntry } from "astro:content";
import "../../styles/global.css";
import { getCollection, render } from "astro:content";

import PortfolioPost from "../../layouts/portfoliopost.astro";
import { getEntrySlug } from "../../utils/content";

type Props = CollectionEntry<"portfolio">;

export async function getStaticPaths() {
  const portfolios = await getCollection("portfolio");
  return portfolios
    .map(portfolio => ({
      params: { slug: getEntrySlug(portfolio) },
      props: portfolio,
    }))
    .sort((a, b) => {
      const dateA = new Date(a.props.data.publishedDate as Date);
      const dateB = new Date(b.props.data.publishedDate as Date);
      return dateA.getTime() - dateB.getTime();
    })
    .filter(portfolio => portfolio.props.data.isPublished);
}

const portfolio = Astro.props;
const { Content } = await render(portfolio);
const portfolioSlug = getEntrySlug(portfolio);

// Generate OG image URL
const ogImage = `/og/portfolio/${portfolioSlug}.png`;

export const prerender = true;
---

<PortfolioPost {...portfolio.data} ogImage={ogImage}>
  <Content />
</PortfolioPost>
