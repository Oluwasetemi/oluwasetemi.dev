---
import { getCollection } from "astro:content";

import PortfolioCard from "../../components/portfolio-card.astro";
import { SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";

const portfolios = await getCollection("portfolio");
const sortedPortfolios = portfolios.sort((a, b) => {
  const dateA = new Date(a.data.publishedDate as Date);
  const dateB = new Date(b.data.publishedDate as Date);
  return dateB.getTime() - dateA.getTime();
});
---

<Layout
  title={`Portfolio - ${SITE_TITLE}`}
  description="My portfolio of web development projects and work"
  image="/og/page/portfolio.png"
>
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="portfolio-hero">
        <div>
          <p>Build log</p>
          <h1>Projects with fingerprints.</h1>
        </div>
        <aside aria-label="Portfolio count">
          <strong>{sortedPortfolios.length}</strong>
          <span>published projects</span>
        </aside>
      </header>

      {
        sortedPortfolios.length > 0 ? (
          <ul class="portfolio-grid">
            {sortedPortfolios.map((portfolio) => <PortfolioCard portfolio={portfolio} />)}
          </ul>
        ) : (
          <section class="portfolio-empty">
            <h2>Portfolio coming soon</h2>
            <p>I’m currently working on showcasing my projects. Check back soon.</p>
          </section>
        )
      }
    </div>
  </main>
</Layout>

<style>
  .portfolio-hero {
    display: grid;
    gap: 1.25rem;
    align-items: end;
    border-bottom: 1px dashed rgb(212 212 216);
    padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .portfolio-hero {
      grid-template-columns: 1fr auto;
    }
  }

  .portfolio-hero p {
    margin: 0 0 0.75rem;
    color: rgb(20 184 166);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .portfolio-hero h1 {
    max-width: 11ch;
    color: rgb(39 39 42);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .portfolio-hero aside {
    display: grid;
    min-width: 11rem;
    border: 1px dashed rgb(20 184 166 / 0.45);
    border-radius: 1.5rem;
    padding: 1rem;
  }

  .portfolio-hero strong {
    color: rgb(39 39 42);
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.08em;
  }

  .portfolio-hero span {
    color: rgb(113 113 122);
    font-size: 0.8125rem;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.85rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .portfolio-grid :global(li) {
    border-style: dashed;
  }

  .portfolio-empty {
    margin-top: 2rem;
    border: 1px dashed rgb(212 212 216);
    border-radius: 1.5rem;
    padding: 1.5rem;
  }

  :global(.dark) .portfolio-hero {
    border-color: rgb(63 63 70);
  }

  :global(.dark) .portfolio-hero h1,
  :global(.dark) .portfolio-hero strong {
    color: rgb(244 244 245);
  }

  :global(.dark) .portfolio-hero span {
    color: rgb(161 161 170);
  }

  :global(.dark) .portfolio-empty,
  :global(.dark) .portfolio-hero aside {
    border-color: rgb(63 63 70);
  }

  :global(.dark) .portfolio-empty {
    background: rgb(24 24 27 / 0.72);
  }
</style>
