---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Uses - Oluwasetemi" description="Tools, technologies, and setup I use for development and productivity" image="/og/page/uses.png">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 text-gray-800">
    <h1 class="text-3xl sm:text-4xl font-bold mb-4 sm:mb-6 text-gray-900">
      What I Use
      <span role="img" aria-label="tools">🛠️</span>
    </h1>

    <p class="mb-6 leading-relaxed text-gray-600">
      Here's a comprehensive list of the tools, technologies, and setup I use for development, productivity, and daily
      work.
    </p>

    <!-- Development Tools -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">Development Tools</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-indigo-600">Code Editor</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
              <span class="line-through"><strong>VS Code</strong> - Primary editor with default dark theme</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
              <strong>Cursor</strong> - AI-powered coding assistant
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
              <strong>Zed</strong> - reliable code editing experience powered by Rust
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-indigo-600">Terminal & Shell</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
              <strong>Warp</strong> - AI-powered terminal
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
              <strong>Starship</strong> - Cross-shell prompt
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Programming Languages & Frameworks -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">
        Programming Languages & Frameworks
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-green-600">Frontend</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>TypeScript</strong> - Primary language
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>React</strong> - UI library
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>Vue</strong> - UI framework
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>Next.js</strong> - React framework
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>Nuxt</strong> - Vue framework
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>Astro</strong> - Static site generator
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              <strong>Tailwind CSS</strong> - Utility-first CSS
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-blue-600">Backend & Tools</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              <strong>Node.js</strong> - JavaScript runtime
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              <strong>Python</strong> - For AI/ML projects
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              <strong>GraphQL</strong> - API query language
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              <strong>PostgreSQL</strong> - Database
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              <strong>Hono</strong> - Serverless framework
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Productivity Tools -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">
        Productivity & Design
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-purple-600">Productivity</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
              <strong>TablePlus</strong> - Database management
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-purple-600">Communication</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
              <strong>Discord</strong> - Community & team chat
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
              <strong>Screenflow</strong> - Screen recording & tutorials
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Hardware & Setup -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">Hardware & Setup</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-orange-600">Computer</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>MacBook Pro 13"</strong> - Intel i5, 8GB RAM, 256GB SSD
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>External Monitor</strong> - Samsung Curve 34" ViewFinity S6
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>Keyboard</strong> - MX Master 3
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>Mouse</strong> - Logitech MX Master 2S
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold mb-3 text-orange-600">Audio & Video</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>Microphone</strong> - Focusrite Scarlett Solo
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>Headphones</strong> - Bose QC35 II
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>Webcam</strong> - Logitech C920
            </li>
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
              <strong>Lighting</strong> - Ring light for streaming
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Fonts & Themes -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">Fonts & Themes</h2>

      <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-teal-600">Code Fonts</h3>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
                <strong>Operator Mono</strong> - Primary coding font
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
                <strong>Fira Code</strong> - Alternative with ligatures
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
                <strong>IBM Plex Mono</strong> - For documentation
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-semibold mb-3 text-teal-600">VS Code Themes</h3>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
                <strong>One Dark Pro</strong> - Dark theme
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
                <strong>GitHub Light</strong> - Light theme
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-teal-500 rounded-full"></span>
                <strong>Material Icon Theme</strong> - File icons
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Browser Extensions -->
    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">
        Browser Extensions
      </h2>

      <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-red-600">Development</h3>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                <strong>React Developer Tools</strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                <strong>Enhancer for YouTube™ </strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                <strong>Refined GitHub</strong>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-semibold mb-3 text-red-600">Productivity</h3>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                <strong>Grammarly</strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-red-500 rounded-full"></span>
                <strong>uBlock Origin</strong>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold mb-4 text-gray-900 border-b border-gray-200 pb-2">AI Tools</h2>

      <div class="bg-white rounded-lg p-6 shadow-sm border border-gray-100">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-semibold mb-3 text-[#ffc600]">IDE</h3>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[#ffc600] rounded-full"></span>
                <strong>Cursor</strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[#ffc600] rounded-full"></span>
                <strong>Warp</strong>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-semibold mb-3 text-[#ffc600]">Agentic Tools and LLMs</h3>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[#ffc600] rounded-full"></span>
                <strong>Claude Pro, Claude Code</strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[#ffc600] rounded-full"></span>
                <strong>ChatGPT Pro</strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[#ffc600] rounded-full"></span>
                <strong>Gemini Pro</strong>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-2 h-2 bg-[#ffc600] rounded-full"></span>
                <strong>Olama Turbo Mode Free</strong>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <div class="text-center mt-8 pt-6 border-t border-gray-200">
      <p class="text-gray-600 text-sm">
        This list is constantly evolving as I discover new tools and technologies.
        <br class="hidden sm:block" />
        Last updated: {new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </p>
    </div>
  </main>
</Layout>
