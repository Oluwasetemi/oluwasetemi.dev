---
import Layout from "../layouts/Layout.astro";

const sections = [
  {
    title: "Writing code",
    summary: "Editors, terminal, and the surface area where most work happens.",
    tools: [
      { name: "Cursor", detail: "AI-assisted editor for focused implementation." },
      { name: "Zed", detail: "Fast Rust-powered editor for clean writing sessions." },
      { name: "Warp", detail: "Terminal with useful AI workflows." },
      { name: "Starship", detail: "Cross-shell prompt that stays out of the way." },
    ],
  },
  {
    title: "Frontend and backend",
    summary: "The stack I reach for when building web products and teaching the web platform.",
    tools: [
      { name: "TypeScript", detail: "Primary language." },
      { name: "React", detail: "UI library for product work." },
      { name: "Vue", detail: "Framework I still enjoy and teach around." },
      { name: "Next.js / Nuxt", detail: "App frameworks for React and Vue." },
      { name: "Astro", detail: "Static-first publishing and content sites." },
      { name: "Tailwind CSS", detail: "Utility CSS when speed matters." },
      { name: "Node.js", detail: "Backend JavaScript runtime." },
      { name: "Hono", detail: "Small, fast serverless apps." },
      { name: "GraphQL", detail: "API shape for client-heavy products." },
      { name: "PostgreSQL", detail: "Default relational database." },
      { name: "Python", detail: "AI/ML experiments and scripts." },
    ],
  },
  {
    title: "Desk and recording",
    summary: "Hardware for teaching, meetings, and long build sessions.",
    tools: [
      { name: "MacBook Pro 13\"", detail: "Intel i5, 8GB RAM, 256GB SSD." },
      { name: "Samsung Curve 34\" ViewFinity S6", detail: "External monitor." },
      { name: "MX Master 3", detail: "Keyboard." },
      { name: "Logitech MX Master 2S", detail: "Mouse." },
      { name: "Focusrite Scarlett Solo", detail: "Microphone interface." },
      { name: "Bose QC35 II", detail: "Headphones." },
      { name: "Logitech C920", detail: "Webcam." },
      { name: "Ring light", detail: "Simple lighting for streaming." },
    ],
  },
  {
    title: "Taste and utilities",
    summary: "Small tools that make the workspace feel like mine.",
    tools: [
      { name: "TablePlus", detail: "Database management." },
      { name: "Dotfiles", detail: "Configuration I keep versioned.", href: "https://github.com/oluwasetemi/dotfiles" },
      { name: "Cartograph", detail: "Primary coding font." },
      { name: "Operator Mono", detail: "Alternative coding font." },
      { name: "Fira Code", detail: "Alternative with ligatures." },
      { name: "IBM Plex Mono", detail: "Documentation font." },
      { name: "One Dark Pro", detail: "Dark editor theme." },
      { name: "GitHub Light", detail: "Light editor theme." },
      { name: "Material Icon Theme", detail: "File icons." },
    ],
  },
  {
    title: "Browser and AI",
    summary: "Extensions, agents, and language models in the daily loop.",
    tools: [
      { name: "React Developer Tools", detail: "Frontend debugging." },
      { name: "Enhancer for YouTube™", detail: "Better video controls." },
      { name: "Refined GitHub", detail: "GitHub quality-of-life improvements." },
      { name: "Grammarly", detail: "Writing support." },
      { name: "uBlock Origin", detail: "Cleaner browsing." },
      { name: "Claude Pro / Claude Code", detail: "Planning, review, and implementation." },
      { name: "ChatGPT Pro", detail: "Research and synthesis." },
      { name: "Gemini Pro", detail: "Second-opinion model." },
      { name: "Ollama Turbo Mode Free", detail: "Local-model experiments." },
    ],
  },
];
---

<Layout title="Uses - Oluwasetemi" description="Tools, technologies, and setup I use for development and productivity" image="/og/page/uses.png">
  <main id="main-content" tabindex="-1" class="page-container mt-16 sm:mt-20">
    <div class="content-container">
      <header class="uses-hero">
        <p>Workbench</p>
        <h1>The tools I keep because they earn their place.</h1>
        <div class="uses-hero-card">
          <span>Updated {new Date().toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
          <strong>{sections.reduce((count, section) => count + section.tools.length, 0)} items</strong>
        </div>
      </header>

      <div class="uses-stack">
        {sections.map((section, sectionIndex) => (
          <section class="uses-section" aria-labelledby={`uses-section-${sectionIndex}`}>
            <header>
              <span aria-hidden="true">{String(sectionIndex + 1).padStart(2, "0")}</span>
              <div>
                <h2 id={`uses-section-${sectionIndex}`}>{section.title}</h2>
                <p>{section.summary}</p>
              </div>
            </header>
            <ul class="tool-list">
              {section.tools.map(tool => (
                <li>
                  {tool.href ? (
                    <a href={tool.href} target="_blank" rel="noopener noreferrer" class="tool-pill">
                      <strong>{tool.name}</strong>
                      <span>{tool.detail}</span>
                    </a>
                  ) : (
                    <div class="tool-pill">
                      <strong>{tool.name}</strong>
                      <span>{tool.detail}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .uses-hero {
    position: relative;
    display: grid;
    gap: 1.5rem;
    border: 1px dashed rgb(212 212 216);
    border-radius: 2rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    background:
      radial-gradient(circle at top right, rgb(20 184 166 / 0.12), transparent 22rem),
      rgb(255 255 255 / 0.72);
  }

  .uses-hero > p {
    margin: 0;
    color: rgb(20 184 166);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .uses-hero h1 {
    max-width: 13ch;
    color: rgb(39 39 42);
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .uses-hero-card {
    display: flex;
    width: fit-content;
    gap: 0.75rem;
    align-items: center;
    border-radius: 999px;
    background: rgb(244 244 245);
    padding: 0.4rem 0.5rem 0.4rem 0.85rem;
    color: rgb(113 113 122);
    font-size: 0.8125rem;
  }

  .uses-hero-card strong {
    border-radius: 999px;
    background: white;
    padding: 0.25rem 0.6rem;
    color: rgb(39 39 42);
  }

  .uses-stack {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .uses-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    border-bottom: 1px dashed rgb(228 228 231);
    padding: 1.5rem 0;
  }

  @media (min-width: 900px) {
    .uses-section {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .uses-section header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .uses-section header > span {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    border: 1px dashed rgb(20 184 166 / 0.5);
    border-radius: 999px;
    color: rgb(20 184 166);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .uses-section h2 {
    color: rgb(39 39 42);
    font-size: 1.125rem;
    letter-spacing: -0.03em;
  }

  .uses-section p {
    margin: 0.35rem 0 0;
    color: rgb(113 113 122);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool-pill {
    display: inline-flex;
    min-height: 3rem;
    max-width: 20rem;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgb(228 228 231);
    border-radius: 1rem;
    background: white;
    padding: 0.6rem 0.85rem;
    text-decoration: none;
    transition: border-color 160ms ease, transform 180ms cubic-bezier(0.23, 1, 0.32, 1), background-color 160ms ease;
  }

  a.tool-pill:hover,
  a.tool-pill:focus-visible,
  .tool-pill:hover {
    border-color: rgb(20 184 166 / 0.6);
    transform: translateY(-1px);
  }

  a.tool-pill:focus-visible {
    outline: 2px solid rgb(20 184 166 / 0.28);
    outline-offset: 3px;
  }

  .tool-pill strong {
    color: rgb(39 39 42);
    font-size: 0.875rem;
  }

  .tool-pill span {
    margin-top: 0.1rem;
    color: rgb(113 113 122);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  :global(.dark) .uses-hero {
    border-color: rgb(63 63 70);
    background:
      radial-gradient(circle at top right, rgb(45 212 191 / 0.1), transparent 22rem),
      rgb(24 24 27 / 0.72);
  }

  :global(.dark) .uses-hero h1,
  :global(.dark) .uses-section h2,
  :global(.dark) .tool-pill strong,
  :global(.dark) .uses-hero-card strong {
    color: rgb(244 244 245);
  }

  :global(.dark) .uses-hero-card {
    background: rgb(39 39 42);
  }

  :global(.dark) .uses-hero-card strong,
  :global(.dark) .tool-pill {
    background: rgb(24 24 27);
  }

  :global(.dark) .uses-section {
    border-color: rgb(63 63 70);
  }

  :global(.dark) .tool-pill {
    border-color: rgb(63 63 70);
  }

  :global(.dark) .tool-pill span,
  :global(.dark) .uses-section p {
    color: rgb(161 161 170);
  }
</style>
