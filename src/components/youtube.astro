---
export interface Props {
  id: string;
  title?: string;
  aspectRatio?: '16/9' | '4/3';
}

const { id, title = 'YouTube video', aspectRatio = '16/9' } = Astro.props;
const paddingBottom = aspectRatio === '16/9' ? '56.25%' : '75%';
---

<div class="youtube-embed my-8">
  <div class="video-container" style={`padding-bottom: ${paddingBottom}`}>
    <iframe
      src={`https://www.youtube.com/embed/${id}`}
      title={title}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
</div>

<style>
  .youtube-embed {
    max-inline-size: 100%;
  }

  .video-container {
    position: relative;
    block-size: 0;
    inline-size: 100%;
    overflow: clip;
    border-radius: 0.5rem;
    box-shadow:
      0 4px 6px -1px color-mix(in srgb, var(--shadow-color) 10%, transparent),
      0 2px 4px -1px color-mix(in srgb, var(--shadow-color) 6%, transparent);

    iframe {
      position: absolute;
      inset: 0;
      block-size: 100%;
      inline-size: 100%;
      border-radius: inherit;
    }
  }
</style>
