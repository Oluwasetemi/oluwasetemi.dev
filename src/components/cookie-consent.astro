---
// Cookie Consent Banner Component
---

<aside
  id="cookie-consent"
  class="fixed inset-x-4 bottom-4 z-50 hidden rounded-2xl border border-dashed border-zinc-700/70 bg-zinc-950/95 p-4 text-white shadow-2xl shadow-zinc-950/20 backdrop-blur sm:inset-x-auto sm:left-4 sm:max-w-xl"
  aria-label="Cookie notice"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-md">
      <p class="m-0 text-sm font-medium text-zinc-100">Cookies and analytics</p>
      <p class="mt-1 text-sm leading-6 text-zinc-300">
        I use an optional analytics cookie to understand traffic after you accept. You can decline and still use the site.
        <a href="/privacy" class="font-medium text-teal-300 underline decoration-dashed underline-offset-4 hover:text-teal-200">Read the privacy policy</a>.
      </p>
    </div>
    <div class="flex shrink-0 gap-2">
      <button
        id="cookie-decline"
        class="rounded-full border border-zinc-700 px-4 py-2 text-sm font-medium text-zinc-200 transition hover:border-zinc-500 hover:text-white"
      >
        Decline
      </button>
      <button
        id="cookie-accept"
        class="rounded-full bg-teal-400 px-4 py-2 text-sm font-semibold text-zinc-950 transition hover:bg-teal-300"
      >
        Accept
      </button>
    </div>
  </div>
</aside>

<script>
  // Cookie consent handling
  const COOKIE_NAME = 'cookie-consent';
  const COOKIE_EXPIRY_DAYS = 365;

  function setCookie(name: string, value: string, days: number) {
    const date = new Date();
    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
    const expires = `expires=${date.toUTCString()}`;
    document.cookie = `${name}=${value};${expires};path=/;SameSite=Lax;Secure;`;
  }

  function getCookie(name: string): string | null {
    const nameEQ = `${name}=`;
    const cookies = document.cookie.split(';');
    for (let cookie of cookies) {
      cookie = cookie.trim();
      if (cookie.indexOf(nameEQ) === 0) {
        return cookie.substring(nameEQ.length);
      }
    }
    return null;
  }

  function showConsentBanner() {
    const banner = document.getElementById('cookie-consent');
    if (banner) {
      banner.classList.remove('hidden');
    }
  }

  function hideConsentBanner() {
    const banner = document.getElementById('cookie-consent');
    if (banner) {
      banner.classList.add('hidden');
    }
  }

  function handleConsent(accepted: boolean) {
    setCookie(COOKIE_NAME, accepted ? 'accepted' : 'declined', COOKIE_EXPIRY_DAYS);
    hideConsentBanner();

    // Dispatch custom event for GA to listen to
    window.dispatchEvent(new CustomEvent('cookie-consent', {
      detail: { accepted }
    }));

    // If accepted, trigger GA initialization
    if (accepted && typeof window.initGoogleAnalytics === 'function') {
      window.initGoogleAnalytics();
    }
  }

  // Check if consent was already given
  document.addEventListener('DOMContentLoaded', () => {
    const consent = getCookie(COOKIE_NAME);

    if (!consent) {
      // No consent yet, show banner
      showConsentBanner();
    }
    else if (consent === 'accepted') {
      // Consent was given, trigger GA initialization
      window.dispatchEvent(new CustomEvent('cookie-consent', {
        detail: { accepted: true }
      }));
    }

    // Event listeners for buttons
    const acceptBtn = document.getElementById('cookie-accept');
    const declineBtn = document.getElementById('cookie-decline');

    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => handleConsent(true));
    }

    if (declineBtn) {
      declineBtn.addEventListener('click', () => handleConsent(false));
    }
  });

  // Extend Window interface for TypeScript
  declare global {
    interface Window {
      initGoogleAnalytics?: () => void;
    }
  }
</script>
