---
import { SITE_AUTHOR, SITE_TITLE, SOCIALS } from "../consts";

const links = [
  { href: "/blog", label: "Blog" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/about", label: "About" },
  { href: "/links", label: "Links" },
  { href: "/uses", label: "Uses" },
  { href: "/tags", label: "Tags" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const twitter = SOCIALS.twitter.replace(/^@/, "");
---

<header class="relative z-50 pt-6 sm:pt-8">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="group flex items-center gap-3 no-underline" aria-label={`${SITE_AUTHOR} home`}>
        <img
          src="/images/profile-pic.jpg"
          alt=""
          class="h-10 w-10 rounded-full bg-zinc-100 object-cover p-0.5 shadow-lg ring-1 shadow-zinc-900/5 transition group-hover:scale-105 dark:bg-zinc-800 dark:ring-white/10"
          loading="eager"
        />
        <span class="hidden text-sm font-semibold text-zinc-900 dark:text-zinc-100 sm:inline">{SITE_TITLE}</span>
      </a>

      <nav aria-label="Primary" class="hidden rounded-full bg-white/90 px-3 text-sm font-medium text-zinc-800 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur md:block dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10">
        <ul class="m-0 flex list-none p-0">
          {links.map(link => (
            <li class="m-0">
              <a
                href={link.href}
                class:list={[
                  "relative block px-3 py-2 transition hover:text-teal-500 dark:hover:text-teal-400",
                  isActive(link.href) && "text-teal-500 dark:text-teal-400",
                ]}
              >
                {link.label}
                {isActive(link.href) && <span class="absolute inset-x-1 -bottom-px h-px bg-linear-to-r from-teal-500/0 via-teal-500/40 to-teal-500/0 dark:via-teal-400/40" />}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <div class="hidden items-center gap-3 text-zinc-500 sm:flex dark:text-zinc-400">
          <button
            type="button"
            class="theme-toggle inline-flex h-8 items-center gap-2 rounded-full border border-dashed border-zinc-300 px-3 text-xs font-medium text-zinc-700 transition hover:border-teal-500/60 hover:text-zinc-950 active:scale-[0.98] dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-teal-400/60 dark:hover:text-zinc-50"
            aria-label="Switch theme"
          >
            <span class="h-2 w-2 rounded-full bg-teal-500 dark:bg-teal-400" aria-hidden="true"></span>
            <span class="theme-toggle-text">Theme</span>
          </button>
          <a href={`https://github.com/${SOCIALS.github}`} class="transition hover:text-zinc-900 dark:hover:text-zinc-100" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 16 16" class="h-5 w-5" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
          </a>
          <a href={`https://x.com/${twitter}`} class="transition hover:text-zinc-900 dark:hover:text-zinc-100" target="_blank" rel="noopener noreferrer" aria-label="X">
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z" /></svg>
          </a>
          <a href={`https://linkedin.com/in/${SOCIALS.linkedIn}`} class="transition hover:text-zinc-900 dark:hover:text-zinc-100" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.119 20.452H3.555V9h3.564z" /></svg>
          </a>
        </div>

        <details class="relative md:hidden">
          <summary class="list-none rounded-full bg-white/90 px-4 py-2 text-sm font-medium text-zinc-800 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur marker:hidden dark:bg-zinc-800/90 dark:text-zinc-200 dark:ring-white/10">
            Menu
          </summary>
          <nav aria-label="Primary mobile" class="absolute right-0 mt-3 w-56 rounded-2xl bg-white p-3 text-sm font-medium text-zinc-800 shadow-xl ring-1 ring-zinc-900/5 dark:bg-zinc-900 dark:text-zinc-200 dark:ring-white/10">
            <button
              type="button"
              class="theme-toggle mb-2 flex w-full items-center justify-between rounded-xl border border-dashed border-zinc-200 px-3 py-2 text-left text-sm text-zinc-700 transition hover:border-teal-500/60 hover:text-zinc-950 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-teal-400/60 dark:hover:text-zinc-50"
              aria-label="Switch theme"
            >
              <span class="theme-toggle-text">Theme</span>
              <span class="h-2 w-2 rounded-full bg-teal-500 dark:bg-teal-400" aria-hidden="true"></span>
            </button>
            {links.map(link => <a href={link.href} class="block rounded-xl px-3 py-2 transition hover:bg-zinc-50 hover:text-teal-500 dark:hover:bg-zinc-800">{link.label}</a>)}
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const updateThemeButtons = () => {
      const isDark = document.documentElement.classList.contains("dark");
      document.querySelectorAll(".theme-toggle").forEach((button) => {
        button.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");
      });
      document.querySelectorAll(".theme-toggle-text").forEach((label) => {
        label.textContent = isDark ? "Light" : "Dark";
      });
    };

    document.querySelectorAll(".theme-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        const shouldUseDark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", shouldUseDark);
        localStorage.setItem("theme", shouldUseDark ? "dark" : "light");
        updateThemeButtons();
      });
    });

    updateThemeButtons();
    document.addEventListener("astro:page-load", updateThemeButtons);
  })();
</script>
