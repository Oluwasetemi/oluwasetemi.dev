---
import type { CollectionEntry } from "astro:content";

import { getEntrySlug } from "../utils/content";

type Props = {
  portfolio: CollectionEntry<"portfolio">;
};

const { portfolio } = Astro.props;
const portfolioSlug = getEntrySlug(portfolio);
const stack = portfolio.data.tags || portfolio.data.tech || portfolio.data.technology || [];
---

<li class="group relative rounded-2xl border border-dashed border-zinc-200 bg-white/75 p-6 transition hover:border-teal-500/50 hover:bg-white dark:border-zinc-700 dark:bg-zinc-900/70 dark:hover:border-teal-400/50 dark:hover:bg-zinc-900">
  <h3 class="text-base font-semibold text-zinc-800 dark:text-zinc-100">
    <a href={`/portfolio/${portfolioSlug}/`}>
      <span class="absolute inset-0 rounded-2xl"></span>
      {portfolio.data.title}
    </a>
  </h3>
  {portfolio.data.description && <p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{portfolio.data.description}</p>}
  {stack.length > 0 && (
    <div class="relative z-10 mt-4 flex flex-wrap gap-2">
      {stack.slice(0, 4).map((tag: string) => (
        <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
          {tag}
        </span>
      ))}
    </div>
  )}
  <p class="relative z-10 mt-6 flex items-center text-sm font-medium text-teal-500">
    View project
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="ml-1 h-4 w-4 stroke-current transition group-hover:translate-x-0.5"><path d="M6.75 5.75 9.25 8l-2.5 2.25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </p>
</li>
