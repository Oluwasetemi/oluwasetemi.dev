---
type Props = {
  portfolio: {
    id: string;
    data: {
      title: string;
      description?: string;
      url?: string;
      github?: string;
      tags?: string[];
      tech?: string[];
      imageUrl?: string;
    };
  };
  size?: "small" | "large";
};

import { getEntrySlug } from "../utils/content";

const { portfolio, size = "large" } = Astro.props;
const { data } = portfolio;
const portfolioSlug = getEntrySlug(portfolio);
---

<article class={`portfolio-card ${size}`}>
  <div class="card-image">
    <a href={`/portfolio/${portfolioSlug}/`}>
      <img src={data.imageUrl || "/images/placeholder.jpg"} alt={data.title} />
    </a>
  </div>
  <div class="card-details">
    {
      data.url && (
        <a href={data.url} target="_blank" rel="noopener noreferrer" class="title-link">
          <h2>
            {data.title}
            <img class="icon" src="/exit-top-right.svg" alt="external link" />
          </h2>
        </a>
      )
    }
    {!data.url && <h2>{data.title}</h2>}

    {
      (data.tech || data.tags) && (
        <div class="tech">
          {(data.tech || data.tags)?.map(technology => (
            <span class="tech-tag">{technology}</span>
          ))}
        </div>
      )
    }

    {
      data.description && (
        <a href={`/portfolio/${portfolioSlug}/`}>
          <p class="description">{data.description}</p>
        </a>
      )
    }
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    align-items: center;
    margin-block-end: 2rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 0.75rem;
    background: var(--color-surface);
    padding: 1.5rem;
    box-shadow: 0 4px 6px color-mix(in srgb, var(--shadow-color) 10%, transparent);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 25px color-mix(in srgb, var(--shadow-color) 15%, transparent);
    }

    &.small {
      max-inline-size: 28.125rem;
    }

    @media (max-width: 768px) {
      flex-direction: column;
      text-align: center;
    }
  }

  .card-image {
    flex: none;
    margin-inline-end: 2rem;

    img {
      block-size: auto;
      max-inline-size: 12.5rem;
      border-radius: 0.5rem;
      transition: transform 200ms ease;

      &:hover {
        transform: scale(1.05);
      }
    }

    @media (max-width: 768px) {
      margin-block-end: 1rem;
      margin-inline-end: 0;

      img {
        max-inline-size: 100%;
      }
    }
  }

  .card-details {
    flex: 1;
    min-inline-size: 0;

    h2 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0 0 1rem;
      font-size: 1.5rem;
    }
  }

  .title-link {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--color-accent);
    }
  }

  .icon {
    block-size: 1rem;
    inline-size: 1rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 1rem;

    @media (max-width: 768px) {
      justify-content: center;
    }
  }

  .tech-tag {
    border-radius: 0.25rem;
    background: var(--color-surface-muted);
    padding: 0.25rem 0.5rem;
    color: var(--color-copy);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .description {
    color: var(--color-muted);
    line-height: 1.6;
    text-decoration: none;

    &:hover {
      color: var(--color-heading);
    }
  }
</style>
