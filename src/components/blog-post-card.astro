---
import type { CollectionEntry } from "astro:content";

import FormattedDate from "./formatteddate.astro";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
---

<li
  class="bg-white rounded-xl p-6 shadow-md hover:-translate-y-1 hover:shadow-xl transition-all duration-200 border border-gray-200"
>
  <a href={`/blog/${post.slug}/`} class="block no-underline">
    <h4 class="text-xl font-semibold mb-2 text-gray-800 leading-tight hover:text-indigo-600 transition-colors">
      {post.data.title}
    </h4>
    <p class="text-gray-500 text-sm mb-4">
      <FormattedDate date={post.data.pubDate || post.data.date} />
    </p>
    {
      post.data.tags && (
        <div class="flex gap-2 flex-wrap mt-4">
          {post.data.tags.map(tag => (
            <a
              href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}
              class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm hover:bg-indigo-100 hover:text-indigo-700 transition-colors no-underline"
              onclick="event.stopPropagation()"
            >
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </a>
</li>
