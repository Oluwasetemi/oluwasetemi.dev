---
import { SITE_AUTHOR } from "../consts";

const links = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/links", label: "Links" },
  { href: "/uses", label: "Uses" },
  { href: "/tags", label: "Tags" },
  { href: "/privacy", label: "Privacy" },
];
---

<footer class="mt-24 flex-none sm:mt-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="border-t border-zinc-100 py-10 dark:border-zinc-700/40">
      <div class="mx-auto max-w-2xl lg:max-w-5xl">
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
          <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-zinc-800 dark:text-zinc-200">
            {links.map(link => <a href={link.href} class="transition hover:text-teal-500 dark:hover:text-teal-400">{link.label}</a>)}
          </nav>
          <p class="m-0 text-sm text-zinc-400 dark:text-zinc-500">
            &copy; {new Date().getFullYear()} {SITE_AUTHOR}. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
