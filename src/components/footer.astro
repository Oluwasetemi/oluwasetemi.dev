    <a href={`https://stackblitz.com/${SOCIALS.stackblitz}`} target="_blank">
      <span class="sr-only">Follow {SITE_AUTHOR} on Stackblitz</span>
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
