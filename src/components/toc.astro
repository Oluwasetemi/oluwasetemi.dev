---
export interface Props {
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---

{tocHeadings.length > 0 && (
  <aside class="toc-shell" aria-labelledby="toc-title">
    <nav class="toc-panel" aria-label="Table of contents">
      <h2 id="toc-title" class="toc-title">On this page</h2>
      <ol class="toc-list">
        <span class="toc-cursor" aria-hidden="true"></span>
        {tocHeadings.map(heading => (
          <li class:list={["toc-item", heading.depth === 2 ? "toc-item-h2" : "toc-item-h3"]}>
            <a href={`#${heading.slug}`} class="toc-link" data-toc-link>
              <span>{heading.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>
)}

<style>
  .toc-shell {
    display: none;

    &::-webkit-scrollbar {
      inline-size: 0;
    }

    @media (min-width: 1720px) {
      position: fixed;
      inset: 7rem auto auto calc(50% + 35rem);
      z-index: 10;
      display: block;
      max-block-size: calc(100dvh - 9rem);
      inline-size: 13rem;
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.125rem 0.25rem 0.125rem 0;
      scrollbar-gutter: stable;
    }
  }

  .toc-panel {
    color: var(--color-muted);
  }

  .toc-title {
    margin: 0 0 0.875rem;
    padding-inline-start: 1.35rem;
    color: var(--color-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25rem;
  }

  .toc-list {
    --toc-line: var(--color-border-soft);
    --toc-line-strong: color-mix(in srgb, var(--color-accent) 72%, transparent);
    --toc-hover: var(--color-heading);
    --toc-cursor-y: 0px;
    --toc-cursor-height: 0px;
    position: relative;
    margin: 0;
    padding: 0.125rem 0 0.125rem 1.35rem;
    list-style: none;

    &::before {
      position: absolute;
      inset: 0.45rem auto 0.45rem 0.25rem;
      inline-size: 1px;
      border-radius: 999px;
      background: linear-gradient(to bottom, transparent, var(--toc-line) 0.75rem, var(--toc-line) calc(100% - 0.75rem), transparent);
      content: "";
    }

    &:has(.toc-link.is-active) .toc-cursor {
      opacity: 1;
      transform: scale(1);
    }
  }

  .toc-cursor {
    position: absolute;
    inset: var(--toc-cursor-y) auto auto 1.02rem;
    z-index: -1;
    block-size: var(--toc-cursor-height);
    inline-size: calc(100% - 0.6rem);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 8%, transparent);
    opacity: 0;
    transform: scale(0.985);
    transform-origin: left center;
    transition:
      inset-block-start 220ms cubic-bezier(0.23, 1, 0.32, 1),
      block-size 220ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity var(--transition-color),
      transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .toc-item {
    position: relative;
    margin: 0;

    &:has(.toc-link:is(:hover, :focus-visible, .is-active))::before {
      background: var(--toc-line-strong);
    }
  }

  .toc-item-h2 {
    &::before {
      position: absolute;
      inset: 0.82rem auto auto -1.18rem;
      block-size: 0.38rem;
      inline-size: 0.38rem;
      border-radius: 999px;
      background: var(--toc-line);
      content: "";
      pointer-events: none;
      transition: background-color var(--transition-color), transform var(--transition-movement);
    }

    &:has(.toc-link.is-active)::before {
      transform: scale(1.28);
    }
  }

  .toc-item-h3 {
    padding-inline-start: 1.05rem;

    &::before,
    &::after {
      position: absolute;
      inset-inline-start: -1.1rem;
      border-radius: 999px;
      background: var(--toc-line);
      content: "";
      pointer-events: none;
      transition: background-color var(--transition-color), opacity var(--transition-color), transform var(--transition-movement);
    }

    &::before {
      inset-block-start: 0.86rem;
      block-size: 1px;
      inline-size: 0.9rem;
    }

    &::after {
      inset-block-start: 0.48rem;
      block-size: 0.42rem;
      inline-size: 1px;
      opacity: 0.9;
    }

    &:has(.toc-link.is-active) {
      &::before {
        transform: scaleX(1.12);
        transform-origin: left center;
      }

      &::after {
        background: var(--toc-line-strong);
      }
    }

    .toc-link {
      color: var(--color-subtle);
      font-size: 0.75rem;
    }
  }

  .toc-link {
    position: relative;
    display: block;
    padding: 0.285rem 0.45rem 0.285rem 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.25rem;
    text-decoration: none;
    text-wrap: pretty;
    transition: color var(--transition-color), opacity var(--transition-color), transform var(--transition-movement);

    span {
      display: inline;
      background-image: linear-gradient(currentColor, currentColor);
      background-position: 0 100%;
      background-repeat: no-repeat;
      background-size: 0 1px;
      transition: background-size var(--transition-movement);
    }

    &:is(:hover, :focus-visible) {
      color: var(--toc-hover);

      span {
        background-size: 100% 1px;
      }
    }

    &:focus-visible {
      border-radius: 0.45rem;
      outline: 2px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
      outline-offset: 3px;
    }

    &.is-active {
      color: var(--color-accent);
      font-weight: 500;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :where(.toc-cursor, .toc-link, .toc-link span, .toc-item-h2::before, .toc-item-h3::before, .toc-item-h3::after) {
      transition: none;
    }
  }
</style>

<script>
  function initTOC() {
    const shell = document.querySelector<HTMLElement>('.toc-shell');
    const list = document.querySelector<HTMLElement>('.toc-list');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const headings = Array.from(document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]'));

    if (!shell || !list || links.length === 0 || headings.length === 0) return;

    const tocWindow = window as Window & { __oluwasetemiTocCleanup?: () => void };
    const shellElement = shell;
    const listElement = list;

    tocWindow.__oluwasetemiTocCleanup?.();

    let activeId = '';
    let ticking = false;
    let lockedActiveId = '';
    let unlockActiveTimer: number | undefined;
    const byId = new Map(links.map(link => [decodeURIComponent(link.hash.slice(1)), link]));

    function moveCursor(link: HTMLAnchorElement) {
      const item = link.closest<HTMLElement>('.toc-item');
      if (!item) return;

      listElement.style.setProperty('--toc-cursor-y', `${item.offsetTop}px`);
      listElement.style.setProperty('--toc-cursor-height', `${item.offsetHeight}px`);
    }

    function setActive(id: string) {
      if (!id || id === activeId) return;
      activeId = id;

      links.forEach(link => {
        link.classList.remove('is-active');
        link.removeAttribute('aria-current');
      });

      const activeLink = byId.get(id);
      if (!activeLink) return;

      activeLink.classList.add('is-active');
      activeLink.setAttribute('aria-current', 'location');
      moveCursor(activeLink);

      const linkRect = activeLink.getBoundingClientRect();
      const shellRect = shellElement.getBoundingClientRect();
      if (linkRect.top < shellRect.top + 24 || linkRect.bottom > shellRect.bottom - 24) {
        activeLink.scrollIntoView({ block: 'nearest' });
      }
    }

    function updateActiveLink() {
      ticking = false;

      if (lockedActiveId) {
        const lockedLink = byId.get(lockedActiveId);
        if (lockedLink) moveCursor(lockedLink);
        return;
      }

      const current = headings
        .filter(heading => heading.getBoundingClientRect().top <= 140)
        .at(-1) ?? headings[0];

      setActive(current.id);
    }

    function unlockActiveLink() {
      if (!lockedActiveId) return;
      lockedActiveId = '';
      if (unlockActiveTimer) window.clearTimeout(unlockActiveTimer);
      unlockActiveTimer = undefined;
      updateActiveLink();
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateActiveLink);
    }

    function onResize() {
      const activeLink = activeId ? byId.get(activeId) : null;
      if (activeLink) moveCursor(activeLink);
    }

    const linkCleanups = links.map(link => {
      const onClick = (event: MouseEvent) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const target = document.getElementById(id);
        if (!target) return;

        event.preventDefault();
        lockedActiveId = id;
        setActive(id);
        history.pushState(null, '', link.hash);

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' });

        if (unlockActiveTimer) window.clearTimeout(unlockActiveTimer);
        unlockActiveTimer = window.setTimeout(unlockActiveLink, prefersReducedMotion ? 0 : 1400);
      };
      link.addEventListener('click', onClick);
      return () => link.removeEventListener('click', onClick);
    });

    updateActiveLink();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('scrollend', unlockActiveLink);
    window.addEventListener('resize', onResize);

    tocWindow.__oluwasetemiTocCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('scrollend', unlockActiveLink);
      window.removeEventListener('resize', onResize);
      if (unlockActiveTimer) window.clearTimeout(unlockActiveTimer);
      linkCleanups.forEach(cleanup => cleanup());
    };
  }

  document.addEventListener('DOMContentLoaded', initTOC);
  document.addEventListener('astro:page-load', initTOC);
</script>
