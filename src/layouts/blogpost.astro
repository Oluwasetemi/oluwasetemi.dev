---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/basehead.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import FormattedDate from "../components/formatteddate.astro";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, date, updatedDate, heroImage } = Astro.props;
---

<Layout title={title} description={description || `Blog post: ${title}`}>
  <main class="w-full max-w-full m-0">
    <article>
      <div class="w-full">
        {
          heroImage && (
            <img width={1020} height={510} src={heroImage} alt="" class="block mx-auto rounded-xl shadow-lg" />
          )
        }
      </div>
      <div class="max-w-4xl mx-auto px-4 py-8 text-gray-800">
        <div class="mb-8 py-8 text-center leading-tight">
          <div class="mb-4 text-gray-600">
            <FormattedDate date={date} />
            {
              updatedDate && (
                <div class="italic">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <!-- <h1 class="m-0 mb-4">{title}</h1> -->
          <hr class="border-gray-200" />
        </div>
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Layout>
