---
import type { CollectionEntry } from "astro:content";

import { Image } from "astro:assets";
import { micromark } from "micromark";

import FormattedDate from "../components/formatteddate.astro";
import TOC from "../components/toc.astro";
import TextToSpeech from "../components/text-to-speech.astro";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"blog">["data"] & {
  headings?: {
    depth: number;
    slug: string;
    text: string;
  }[];
  ogImage?: string;
};

const { title, description, date, pubDate, banner, updatedDate, bannerCredit, modified, modifiedDate, tags, headings, ogImage } = Astro.props;
const publishedDate = pubDate || date;
const descriptionHtml = description ? micromark(description).replace(/^<p>|<\/p>\n?$/g, "") : "";
---

<Layout title={title} description={description || `Blog post: ${title}`} image={ogImage} type="article">
  <div class="page-container mt-12 sm:mt-16">
    {headings && <TOC headings={headings} />}
    <main id="main-content" tabindex="-1" class="content-container">
      <article class="post-shell">
        <header class="post-hero">
          <div>
            <a href="/blog" class="post-back">← Blog</a>
            <h1>{title}</h1>
            {descriptionHtml && <p class="post-description" set:html={descriptionHtml} />}
          </div>
          <aside aria-label="Article details" class="post-meta-card">
            {publishedDate && (
              <p>
                <span>Published</span>
                <strong><FormattedDate date={publishedDate} /></strong>
              </p>
            )}
            {(updatedDate || modified) && (
              <p>
                <span>Updated</span>
                <strong><FormattedDate date={updatedDate || modifiedDate} /></strong>
              </p>
            )}
            {tags && tags.length > 0 && (
              <p>
                <span>Topics</span>
                <strong>{tags.slice(0, 3).join(", ")}</strong>
              </p>
            )}
          </aside>
        </header>

        {
          banner && (
            <figure class="post-cover">
              <Image src={banner} alt={`Cover image for ${title}`} />
              {bannerCredit && <figcaption>{bannerCredit}</figcaption>}
            </figure>
          )
        }

        <div class="post-body-wrap">
          <TextToSpeech />
          <div class="prose post-content">
            <slot />
          </div>

          {tags && tags.length > 0 && (
            <footer class="post-tags" aria-label="Article tags">
              <h2>Tagged with</h2>
              <div>
                {tags.map(tag => (
                  <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, "-")}/`}>{tag}</a>
                ))}
              </div>
            </footer>
          )}

          <section class="post-comments" aria-labelledby="comments-title">
            <h2 id="comments-title">Comments</h2>
            <div
              class="giscus"
              data-repo={import.meta.env.PUBLIC_GISCUS_REPO || 'Oluwasetemi/oluwasetemi.dev'}
              data-repo-id={import.meta.env.PUBLIC_GISCUS_REPO_ID || 'MDEwOlJlcG9zaXRvcnk1NzMzODI5Mg=='}
              data-category={import.meta.env.PUBLIC_GISCUS_CATEGORY || 'General'}
              data-category-id={import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOA2rptM4CzZAp'}
            ></div>
          </section>
        </div>
      </article>
    </main>
  </div>
</Layout>

<style>
  .post-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    min-inline-size: 0;
    inline-size: 100%;
  }

  .post-hero {
    display: grid;
    align-items: end;
    gap: 1.25rem;
    min-inline-size: 0;
    inline-size: 100%;
    border-block-end: 1px dashed var(--color-border);
    padding-block-end: 2rem;

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }

    & > div {
      min-inline-size: 0;
    }

    h1 {
      max-inline-size: 13ch;
      overflow-wrap: anywhere;
      color: var(--color-heading);
      font-size: clamp(2.75rem, 7vw, 6.25rem);
      font-weight: 760;
      letter-spacing: -0.075em;
      line-height: 0.9;
    }
  }

  .post-back {
    display: inline-flex;
    margin-block-end: 1rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .post-description {
    max-inline-size: 44rem;
    margin-block-start: 1.25rem;
    overflow-wrap: anywhere;
    color: var(--color-copy);
    font-size: 1rem;
    line-height: 1.75;

    :global(code) {
      border-radius: 0.35rem;
      background: var(--color-surface-muted);
      padding: 0.05rem 0.3rem;
    }
  }

  .post-meta-card {
    position: relative;
    z-index: 20;
    display: grid;
    gap: 0.85rem;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 1.5rem;
    background: var(--color-surface-panel);
    padding: 1rem;

    p {
      margin: 0;
    }

    span {
      display: block;
      color: var(--color-subtle);
      font-size: 0.75rem;
    }

    strong {
      display: block;
      margin-block-start: 0.15rem;
      color: var(--color-heading);
      font-size: 0.875rem;
      font-weight: 650;
    }
  }

  .post-cover {
    margin: 0;

    :global(img) {
      max-block-size: 28rem;
      inline-size: 100%;
      border: 1px dashed var(--color-border);
      border-radius: var(--radius-hero);
      box-shadow: none;
      object-fit: cover;
      padding: 0.35rem;
    }

    figcaption {
      margin-block-start: 0.6rem;
      color: var(--color-muted);
      font-size: 0.8125rem;
      font-style: italic;
    }
  }

  .post-body-wrap {
    max-inline-size: 48rem;
    inline-size: 100%;
    margin-inline: auto;
  }

  .post-content :global(> h1:first-child) {
    display: none;
  }

  :is(.post-tags, .post-comments) {
    margin-block-start: 3rem;
    border-block-start: 1px dashed var(--color-border);
    padding-block-start: 1.5rem;

    h2 {
      margin: 0 0 1rem;
      color: var(--color-heading);
      font-size: 1rem;
      letter-spacing: -0.02em;
    }
  }

  .post-tags {
    div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    a {
      border: 1px dashed color-mix(in srgb, var(--color-accent) 45%, transparent);
      border-radius: 999px;
      padding: 0.4rem 0.7rem;
      color: var(--color-accent);
      font-size: 0.8125rem;
      font-weight: 600;
      text-decoration: none;
    }
  }
</style>

<script is:inline>
  // Load Giscus comments
  (function() {
    const giscusContainer = document.querySelector('.giscus');
    if (!giscusContainer) return;

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', giscusContainer.getAttribute('data-repo'));
    script.setAttribute('data-repo-id', giscusContainer.getAttribute('data-repo-id'));
    script.setAttribute('data-category', giscusContainer.getAttribute('data-category'));
    script.setAttribute('data-category-id', giscusContainer.getAttribute('data-category-id'));
    script.setAttribute('data-mapping', 'url');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'bottom');
    script.setAttribute('data-theme', 'preferred_color_scheme');
    script.setAttribute('data-lang', 'en');
    script.setAttribute('data-loading', 'lazy');
    script.setAttribute('crossorigin', 'anonymous');
    script.async = true;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        document.body.appendChild(script);
      });
    } else {
      document.body.appendChild(script);
    }
  })();
</script>
