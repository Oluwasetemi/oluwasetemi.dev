---
import type { CollectionEntry } from "astro:content";

import { micromark } from "micromark";

import FormattedDate from "../components/formatteddate.astro";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"portfolio">["data"] & {
  ogImage?: string;
};

const { title, description, tags, tech, technology, url, github, publishedDate, ogImage } = Astro.props;
const descriptionHtml = description ? micromark(description).replace(/^<p>|<\/p>\n?$/g, "") : "";
const stack = tags || tech || technology || [];
---

<Layout title={title} description={description || `Portfolio project: ${title}`} image={ogImage}>
  <main id="main-content" tabindex="-1" class="page-container mt-12 sm:mt-16">
    <article class="project-shell content-container">
      <header class="project-hero">
        <div>
          <a href="/portfolio" class="project-back">← Portfolio</a>
          <h1>{title}</h1>
          {descriptionHtml && <p class="project-description" set:html={descriptionHtml} />}
        </div>
        <aside class="project-meta-card" aria-label="Project details">
          {publishedDate && (
            <p>
              <span>Published</span>
              <strong><FormattedDate date={publishedDate} /></strong>
            </p>
          )}
          {stack.length > 0 && (
            <p>
              <span>Stack</span>
              <strong>{stack.slice(0, 4).join(", ")}</strong>
            </p>
          )}
          <div class="project-actions">
            {url && (
              <a href={url} target="_blank" rel="noopener noreferrer">Live demo</a>
            )}
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
            )}
          </div>
        </aside>
      </header>

      <div class="project-content prose">
        <slot />
      </div>

      {stack.length > 0 && (
        <footer class="project-tags" aria-label="Project tags">
          <h2>Built with</h2>
          <div>
            {stack.map((tag: string) => <span>{tag}</span>)}
          </div>
        </footer>
      )}
    </article>
  </main>
</Layout>

<style>
  .project-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    min-inline-size: 0;
    inline-size: 100%;
  }

  .project-hero {
    display: grid;
    align-items: end;
    gap: 1.25rem;
    min-inline-size: 0;
    inline-size: 100%;
    border-block-end: 1px dashed var(--color-border);
    padding-block-end: 2rem;

    @media (min-width: 768px) {
      grid-template-columns: minmax(0, 1fr) 16rem;
    }

    & > div {
      min-inline-size: 0;
    }

    h1 {
      max-inline-size: 13ch;
      overflow-wrap: anywhere;
      color: var(--color-heading);
      font-size: clamp(2.75rem, 7vw, 6.25rem);
      font-weight: 760;
      letter-spacing: -0.075em;
      line-height: 0.9;
    }
  }

  .project-back {
    display: inline-flex;
    margin-block-end: 1rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-description {
    max-inline-size: 44rem;
    margin-block-start: 1.25rem;
    overflow-wrap: anywhere;
    color: var(--color-copy);
    font-size: 1rem;
    line-height: 1.75;
  }

  .project-meta-card {
    display: grid;
    gap: 0.9rem;
    border: 1px dashed color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 1.5rem;
    background: var(--color-surface-panel);
    padding: 1rem;

    p {
      margin: 0;
    }

    span {
      display: block;
      color: var(--color-subtle);
      font-size: 0.75rem;
    }

    strong {
      display: block;
      margin-block-start: 0.15rem;
      color: var(--color-heading);
      font-size: 0.875rem;
      font-weight: 650;
    }
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :is(.project-actions a, .project-tags span) {
    border: 1px dashed color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 999px;
    padding: 0.4rem 0.7rem;
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-content {
    max-inline-size: 48rem;
    inline-size: 100%;
    margin-inline: auto;

    :global(> h1:first-child) {
      display: none;
    }
  }

  .project-tags {
    max-inline-size: 48rem;
    inline-size: 100%;
    margin-inline: auto;
    border-block-start: 1px dashed var(--color-border);
    padding-block-start: 1.5rem;

    h2 {
      margin: 0 0 1rem;
      color: var(--color-heading);
      font-size: 1rem;
      letter-spacing: -0.02em;
    }

    div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }
</style>
