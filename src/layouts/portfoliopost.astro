---
import type { CollectionEntry } from "astro:content";

import Footer from "../components/footer.astro";
import Layout from "./Layout.astro";

type Props = CollectionEntry<"portfolio">["data"];

const { title, description, tags, url, github } = Astro.props;
---

<Layout title={title} description={description || `Portfolio project: ${title}`}>
  <main class="w-full max-w-full m-0">
    <article class="prose prose-lg max-w-none text-gray-800 leading-relaxed">
      <div class="max-w-4xl mx-auto px-4 py-8 text-gray-800">
        <div class="mb-8 py-8 text-center leading-tight">
          <div class="mb-4 flex justify-center gap-4 flex-wrap">
            {
              url && (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-6 py-3 rounded-md no-underline font-medium hover:-translate-y-0.5 transition-transform duration-200 text-sm"
                >
                  Live Demo
                </a>
              )
            }
            {
              github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-6 py-3 rounded-md no-underline font-medium hover:-translate-y-0.5 transition-transform duration-200 text-sm"
                >
                  GitHub
                </a>
              )
            }
          </div>
          <hr class="border-gray-200" />
        </div>
        <slot />
        {
          tags && tags.length > 0 && (
            <div class="mt-12 pt-8 border-t border-gray-200">
              <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-4">Tags</h3>
              <div class="flex gap-2 flex-wrap">
                {tags.map((tag: string) => (
                  <span class="bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg text-sm">{tag}</span>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </article>
  </main>
  <Footer />
</Layout>
