---
import type { CollectionEntry } from "astro:content";

import Layout from "./Layout.astro";

type Props = CollectionEntry<"portfolio">["data"] & {
  ogImage?: string;
};

const { title, description, tags, url, github, ogImage } = Astro.props;
---

<Layout title={title} description={description || `Portfolio project: ${title}`} image={ogImage}>
  <main id="main-content" tabindex="-1" class="page-container mt-12 sm:mt-16">
    <article class="prose content-container">
      <div class="mx-auto max-w-3xl py-6 sm:py-8">
        <div class="mb-6 py-4 text-center leading-tight sm:mb-8 sm:py-8">
          <div class="mb-4 flex flex-wrap justify-center gap-3 sm:gap-4">
            {
              url && (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex min-h-[44px] items-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:bg-zinc-700 sm:px-6 sm:py-3 sm:text-base dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
                >
                  Live Demo
                </a>
              )
            }
            {
              github && (
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex min-h-[44px] items-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white no-underline transition hover:bg-zinc-700 sm:px-6 sm:py-3 sm:text-base dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
                >
                  GitHub
                </a>
              )
            }
          </div>
          <hr />
        </div>
        <slot />
        {
          tags && tags.length > 0 && (
            <div class="mt-8 border-t border-zinc-100 pt-6 sm:mt-10 sm:pt-8 lg:mt-12 dark:border-zinc-800">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-wide text-zinc-500 sm:mb-4 sm:text-sm">Tags</h3>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs text-zinc-700 sm:px-3 sm:py-1.5 sm:text-sm dark:bg-zinc-800 dark:text-zinc-300">{tag}</span>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </article>
  </main>
</Layout>
